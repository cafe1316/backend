# Database Configuration
# For Docker development, use: postgresql://cafe1316:cafe1316@postgres:5432/cafe1316
# For local development, use: postgresql://cafe1316:cafe1316@localhost:5432/cafe1316
DATABASE_URL=postgresql://cafe1316:cafe1316@postgres:5432/cafe1316

# JWT Secret (change in production!)
JWT_SECRET=your-secret-key-here

# Application Configuration
NODE_ENV=development
PORT=8080

# PostgreSQL Configuration (for Docker Compose)
POSTGRES_DB=cafe1316
POSTGRES_USER=cafe1316
POSTGRES_PASSWORD=cafe1316
POSTGRES_PORT=5432
